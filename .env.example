# Environment: development | production
NODE_ENV=development

PORT=3001

# MongoDB URI
# Development: mongodb+srv://user:pass@cluster.mongodb.net/homi_dev
# Production: mongodb+srv://user:pass@cluster.mongodb.net/homi_prod
MONGODB_URI=mongodb://localhost:27017/homi

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@homico.ge

# Prelude SMS Verification (https://prelude.so)
PRELUDE_API_KEY=your-prelude-api-key

# OpenAI API Key (for AI tools)
OPENAI_API_KEY=your-openai-api-key

# ===== Payments (added 2026-05) =====

# Which payment provider to use.
#   mock - in-memory dev provider (default in non-prod). NOT allowed in production.
#   bog  - Bank of Georgia E-Commerce. Requires BOG_* credentials below.
PAYMENT_PROVIDER=mock

# BoG E-Commerce credentials (only used when PAYMENT_PROVIDER=bog).
# Get these from your BoG merchant portal: https://business.bog.ge
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# PEM-encoded RSA public key BoG uses to sign webhook payloads.
# Render env vars don't preserve newlines - put the whole PEM on one line
# with literal \n sequences (the backend restores them at init).
# Example:
# BOG_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...AB\n-----END PUBLIC KEY-----
BOG_PUBLIC_KEY=
# Optional - override the OAuth2 / API base URLs for the BoG sandbox.
# Defaults point at production. For sandbox, use BoG's sandbox URLs.
# BOG_OAUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
# BOG_API_BASE=https://api.bog.ge/payments/v1

# Public URL of THIS backend (BoG uses it as the webhook callback target).
# Required when PAYMENT_PROVIDER=bog. Must be reachable from the public
# internet - for local dev use an ngrok tunnel.
PUBLIC_BACKEND_URL=http://localhost:3001

# Public URL of the frontend (used for redirect URLs returning users to
# the pay-return page). Required for both mock and real providers.
FRONTEND_URL=http://localhost:3000
