# Environment: development | production
NODE_ENV=development

PORT=3001

# MongoDB URI
# Development: mongodb+srv://user:pass@cluster.mongodb.net/homi_dev
# Production: mongodb+srv://user:pass@cluster.mongodb.net/homi_prod
MONGODB_URI=mongodb://localhost:27017/homi

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@homico.ge

# Prelude SMS Verification (https://prelude.so)
PRELUDE_API_KEY=your-prelude-api-key

# OpenAI API Key (for AI tools)
OPENAI_API_KEY=your-openai-api-key

# ===== Payments (added 2026-05) =====

# Which payment provider to use.
#   mock  - in-memory dev provider (default in non-prod). NOT allowed in production.
#   flitt - Flitt (flitt.com, formerly Fondy). The live provider. Requires FLITT_* below.
PAYMENT_PROVIDER=mock

# Flitt credentials (only used when PAYMENT_PROVIDER=flitt).
# From the Flitt portal -> Merchant settings -> Basic profile.
# FLITT_MERCHANT_ID = the numeric "Merchant ID".
# FLITT_PAYMENT_KEY = the "Payment key" (signs payment ops). SECRET.
# FLITT_CREDIT_KEY  = the "Credit private key" (only for future Withdrawal/
#                     p2p auto-payouts; leave blank while payouts are manual). SECRET.
FLITT_MERCHANT_ID=
FLITT_PAYMENT_KEY=
FLITT_CREDIT_KEY=
# Optional - override Flitt's API base (defaults to https://pay.flitt.com/api).
# For the Flitt sandbox, point this at the sandbox base.
# FLITT_API_BASE=https://pay.flitt.com/api

# Public URL of THIS backend (Flitt uses it as the server_callback_url / webhook
# target). Required when PAYMENT_PROVIDER=flitt. Must be reachable from the
# public internet - for local dev use an ngrok tunnel.
PUBLIC_BACKEND_URL=http://localhost:3001

# Public URL of the frontend (used for redirect URLs returning users to
# the pay-return page). Required for both mock and real providers.
FRONTEND_URL=http://localhost:3000

# ===== Monitoring (added 2026-06) =====

# Bearer token protecting GET /metrics (Prometheus format, scraped by
# Grafana Cloud's "Metrics Endpoint" integration). Generate a long random
# string, e.g.: openssl rand -hex 32
# If unset, /metrics always returns 401 (closed by default).
METRICS_TOKEN=
